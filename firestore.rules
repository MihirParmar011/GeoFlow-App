rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      // Any user can read profiles (needed for searching usernames during signup)
      allow read: if true;
      // Only the user who owns the profile can update it
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Guests Collection
    match /guests/{guestId} {
      // Any user can read guest profiles
      allow read: if true;
      // Only the guest who owns the profile can update it
      allow write: if request.auth != null && request.auth.uid == guestId;
    }

    // (Future) Live Location Requests/Sessions
    match /live_locations/{locationId} {
      allow read, write: if request.auth != null;
    }
  }
}
