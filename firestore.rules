rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      // Any user can read profiles (needed for searching usernames)
      allow read: if true;
      // Only the user who owns the profile can update it
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Guests Collection
    match /guests/{guestId} {
      // Any user can read guest profiles
      allow read: if true;
      // Only the guest who owns the profile can update it
      allow write: if request.auth != null && request.auth.uid == guestId;
    }

    // Live Locations Collection
    match /live_locations/{userId} {
      // Authenticated users can read live locations (for connected sessions)
      allow read: if request.auth != null;
      // Users can only write their own live location document
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Location Requests / Sessions Collection
    match /location_requests/{requestId} {
      // Authenticated users can read and manage requests they participate in
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
